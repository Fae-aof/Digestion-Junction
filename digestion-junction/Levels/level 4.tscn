[node name="Level 4" type="CanvasLayer" unique_id=475761041]
layer = 2
script = ExtResource("1_k2mch")
texts = Array[String](["Bacteria is everywhere but we can use lysozyme to get rid of it. You've been given some bacteria to help identify it.", "You's also been given bile which makes fat molecules split into smaller globules. Smaller fat molecules break down faster.", "So you know protease breaks down proteins into polypeptides and amino acids. 
But theres a type of protease called pepsin that only breaks them down into polypeptides."])

