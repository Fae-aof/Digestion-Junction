[node name="Level 2" type="CanvasLayer" unique_id=475761041]
layer = 2
script = ExtResource("1_oalwn")
texts = Array[String](["Now we've added mucin and maltase!
When water and mucin mix, they form mucus which softens the molecules, making them break down faster.", "Maltase is an enzyme that breaks down maltose. Maltose is what starch breaks down into.", "Label the solutions and press check: 
amylase breaks down starch
protease breaks down protein
lipase breaks down fats"])

